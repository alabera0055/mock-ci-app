# Copy this file to .env.local and fill it in.

# The value of the Authorization access detail in the Automation setting.
CI_ACCESS_TOKEN=Bearer test123

# Where results are sent. This app runs on your computer, so localhost works.
XISUITE_API_URL=http://localhost:3001/api/v1

# Create one on the Test Management page under API keys. Leave empty to skip sending results.
XISUITE_TM_KEY=

# How long the pretend job runs, in seconds.
JOB_SECONDS=15
